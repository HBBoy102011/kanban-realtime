# SQLite for local development. For PostgreSQL change the provider in prisma/schema.prisma
# and use e.g. postgresql://kanban:kanban@localhost:5432/kanban?schema=public
DATABASE_URL="file:./dev.db"

# Replace both secrets in any environment that is reachable by others.
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"

API_PORT=8787
# Access-token lifetime in seconds. Set a small value (e.g. 5) to check
# that the realtime socket refreshes its session on reconnect.
ACCESS_TOKEN_TTL=900
CLIENT_ORIGIN="http://localhost:5173"
